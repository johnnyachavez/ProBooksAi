# ProBooks+ai — environment variables
# Copy this file to .env and fill in your keys.
# Never commit .env to git.

# ── AI Provider ──────────────────────────────────────────────────────────────
# Set to "anthropic" to use Claude (recommended) or "openai" for GPT-4o.
AI_PROVIDER=anthropic

# ── Anthropic / Claude ───────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model (defaults to claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI (legacy / alternative) ────────────────────────────────────────────
# Only needed when AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Optional: override the OpenAI-compatible base URL (Azure, Ollama, etc.)
# AI_BASE_URL=https://your-endpoint/openai/v1

# ── Future: Telegram bot (Phase 3) ───────────────────────────────────────────
# Create a bot via @BotFather on Telegram, then paste the token here.
# TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# ── Future: Remote API server (Phase 2) ──────────────────────────────────────
# API_HOST=0.0.0.0
# API_PORT=8000
# API_SECRET_KEY=change-me-before-exposing-to-internet
