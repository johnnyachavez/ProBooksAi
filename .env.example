# ProBooks+ai — environment variables
# Copy this file to .env and fill in your keys.
# Never commit .env to git.

# ── AI Provider ──────────────────────────────────────────────────────────────
# Set to "anthropic" to use Claude (recommended) or "openai" for GPT-4o.
AI_PROVIDER=anthropic

# ── Anthropic / Claude ───────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model (defaults to claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI (legacy / alternative) ────────────────────────────────────────────
# Only needed when AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Optional: override the OpenAI-compatible base URL (Azure, Ollama, etc.)
# AI_BASE_URL=https://your-endpoint/openai/v1

# ── Telegram bot ─────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram, then paste the token here.
# Run with: python -m bot.telegram_bot
# Requires: pip install 'python-telegram-bot>=20.0' httpx
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# ── Remote API server ────────────────────────────────────────────────────────
# Run with: uvicorn api.server:app --host 0.0.0.0 --port 8000
# Requires: pip install fastapi uvicorn python-multipart httpx
# API_HOST=0.0.0.0
# API_PORT=8000
API_SECRET_KEY=change-me-before-exposing-to-internet

# URL the Telegram bot uses to reach the API server (defaults to localhost)
# API_BASE_URL=http://127.0.0.1:8000

# Path to the company SQLite file (defaults to the standard probooks path)
# PROBOOKS_DB_PATH=/path/to/company.db
